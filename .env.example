# Скопируйте в .env.local для локальной разработки с облачной базой.
# Без этих переменных приложение работает в локальном режиме (localStorage).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Юзернейм Telegram-бота без @ (необязательно; без него блоки Telegram скрыты).
# Токен бота сюда НЕ кладут — он только в секретах Supabase (TELEGRAM_BOT_TOKEN).
VITE_TELEGRAM_BOT=SatStartBot
